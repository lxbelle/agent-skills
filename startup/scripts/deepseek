#!/bin/sh
# DeepSeek through the Codex CLI (optional client of the Startup reference
# launcher, "Command-line workers"). Runs `codex` with CODEX_HOME=~/.deepseek on
# deepseek-v4-pro with reasoning effort high.
#
# Requires the Codex CLI (`codex`) in PATH. Install: copy this file to a directory
# on PATH as `deepseek` (for example ~/.local/bin/deepseek), chmod 700, and paste
# your DeepSeek API key into DEEPSEEK_API_KEY below. Never commit or share a copy
# that holds the key.
#
# Config, sessions and logs live in ~/.deepseek; the agent works in the current
# directory. The first run creates ~/.deepseek/config.toml and copies the model
# catalog (models.json) out of DeepSeek's official Codex setup script.
#
# Usage: deepseek [codex arguments], e.g. `deepseek` or `deepseek exec "task"`.
# The model, provider and effort are pinned so that project configs cannot
# change them; override them after the subcommand, e.g.
# `deepseek exec -m deepseek-flash -c model_reasoning_effort="max" "task"`.
DEEPSEEK_API_KEY=''

set -eu
home="$HOME/.deepseek"
setup_url="https://cdn.deepseek.com/api-docs/codex-deepseek-setup-en.sh"

[ -n "$DEEPSEEK_API_KEY" ] || { echo "deepseek: paste your DeepSeek API key into DEEPSEEK_API_KEY in $0" >&2; exit 2; }
command -v codex >/dev/null 2>&1 || { echo "deepseek: requires the Codex CLI (codex) in PATH" >&2; exit 127; }

if [ ! -f "$home/config.toml" ] || [ ! -f "$home/models.json" ]; then
  mkdir -p "$home"
  chmod 700 "$home"
  if [ ! -f "$home/models.json" ]; then
    tmp="$home/models.json.tmp.$$"
    curl -fsSL "$setup_url" | sed -n "/<<'CODEX_MODELS_JSON'\$/,/^CODEX_MODELS_JSON\$/p" | sed '1d;$d' > "$tmp"
    grep -q '"deepseek-v4-pro"' "$tmp" || { rm -f "$tmp"; echo "deepseek: no model catalog found in $setup_url" >&2; exit 1; }
    mv "$tmp" "$home/models.json"
  fi
  [ -f "$home/config.toml" ] || cat > "$home/config.toml" <<EOF
# Codex CLI on DeepSeek, written by the \`deepseek\` script. Values follow
# DeepSeek's Codex setup script 1.4.0; the key comes from DEEPSEEK_API_KEY.
model = "deepseek-v4-pro"
model_provider = "deepseek"
model_reasoning_effort = "high"
model_catalog_json = "$home/models.json"
forced_login_method = "api"
web_search = "disabled"
show_raw_agent_reasoning = true

[model_providers.deepseek]
name = "deepseek"
base_url = "https://api.deepseek.com/"
wire_api = "responses"
env_key = "DEEPSEEK_API_KEY"
EOF
  chmod 600 "$home/config.toml" "$home/models.json"
  echo "deepseek: created $home (config.toml, models.json)" >&2
fi

# DeepSeek's catalog introduces the model as "Codex, an agent based on GPT-5";
# rename it so the model calls itself DeepSeek (also fixes older catalogs).
if grep -q 'You are Codex, an agent based on GPT-5' "$home/models.json"; then
  sed -e 's/You are Codex, an agent based on GPT-5\./You are DeepSeek, a coding agent built on a DeepSeek model and running in the Codex CLI./g' \
    -e 's/As Codex, you are/As DeepSeek, you are/g' "$home/models.json" > "$home/models.json.tmp.$$"
  chmod 600 "$home/models.json.tmp.$$"
  mv "$home/models.json.tmp.$$" "$home/models.json"
fi

export DEEPSEEK_API_KEY
export CODEX_HOME="$home"

# Pin the DeepSeek settings as -c overrides. A trusted project's
# .codex/config.toml outranks $CODEX_HOME/config.toml (launched from $HOME,
# that is ~/.codex, the regular Codex config), and a subcommand's own -c list
# replaces the top-level one, so the pins go right after the subcommand
# (exec, exec resume|fork|review, review, resume, fork). Flags the caller gives
# after them, such as -m or -c model_reasoning_effort=..., still win.
case "${1:-}" in
  exec|e) case "${2:-}" in resume|fork|review) at=2 ;; *) at=1 ;; esac ;;
  review|resume|fork) at=1 ;;
  *) at=0 ;;
esac
pins='set -- "$@" -c "model_provider=\"deepseek\"" -c "model=\"deepseek-v4-pro\"" -c "model_reasoning_effort=\"high\"" -c "model_catalog_json=\"$home/models.json\""'
i=0
for arg do
  shift
  [ "$i" -ne "$at" ] || eval "$pins"
  set -- "$@" "$arg"
  i=$((i + 1))
done
[ "$i" -gt "$at" ] || eval "$pins"
exec codex "$@"
